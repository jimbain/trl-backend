{
  "name": "trl-backend",
  "private": true,
  "version": "1.0.0",
  "description": "TRL backend app",
  "license": "MIT",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -- -d src/database/data_source.ts",
    "migration:create": "cd ./src/database/migrations && typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run typeorm migration:run -- -d src/database/data_source.ts",
    "migration:rollback": "npm run typeorm migration:revert -- -d src/database/data_source.ts",
    "migration:show": "npm run typeorm migration:show -- -d src/database/data_source.ts",
    "migration:fresh": "npm run migration:revert && npm run migration:run",
    "schema:sync": "npm run typeorm schema:sync -- -d src/database/data_source.ts",
    "db:clean": "node dist/database/refresh_db.js",
    "db:seed": "node dist/database/seeders/seed.js",
    "fresh-migrate-seed": "npm run db:clean && npm run migration:run && npm run db:seed",
    "prepare": "husky install",
    "elastic:sync-audios": "NODE_OPTIONS='--max-old-space-size=4096' node --expose-gc dist/audios/scripts/sync-audios.js",
    "elastic:sync-by-category": "NODE_OPTIONS='--max-old-space-size=4096' node --expose-gc dist/audios/scripts/sync-audios-by-category.js",
    "deep-links:generate": "NODE_OPTIONS='--max-old-space-size=4096' node --expose-gc dist/audios/scripts/generate-deep-links.js",
    "error-logs:populate-item-info": "NODE_OPTIONS='--max-old-space-size=4096' node --expose-gc dist/app-error-log/scripts/populate-item-info.js",
    "popularity:seed": "node dist/popularity/scripts/seed-popularity.js",
    "ai:backfill-class-vector": "node dist/ai/scripts/run-backfill.js --job class-vector",
    "ai:backfill-embedding": "node dist/ai/scripts/run-backfill.js --job embedding",
    "ai:backfill-categories": "node dist/ai/scripts/run-backfill.js --job categories",
    "ai:fill-embedding-from-temp": "node dist/ai/scripts/fill-embedding-from-temp.js",
    "ai:sync-from-dev": "node dist/ai/scripts/sync-ai-columns-from-dev.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@elastic/elasticsearch": "^9.0.2",
    "@faker-js/faker": "^8.4.1",
    "@fast-csv/format": "^5.0.5",
    "@fast-csv/parse": "^5.0.5",
    "@nestjs/axios": "^3.1.2",
    "@nestjs/common": "^10.3.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.3.2",
    "@nestjs/elasticsearch": "^11.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "@node-saml/passport-saml": "^5.1.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^6.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.0",
    "ioredis": "^5.6.1",
    "lodash": "^4.17.21",
    "mailgun.js": "^10.2.3",
    "multer": "^1.4.5-lts.1",
    "p-limit": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.12.0",
    "pg-query-stream": "^4.10.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.2",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
