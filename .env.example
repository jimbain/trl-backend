# Domain Validation Configuration
# Controls domain validation behavior for authenticated requests
# Options:
#   DISABLE (default): No domain validation - all domains allowed
#   LOG:      Log domain mismatches but allow access (monitoring/audit)
#   RESTRICT: Block requests from unauthorized domains (production)
# Note: localhost and 127.0.0.1 are always allowed for development
# Note: If company domain is empty/null, validation is skipped
DOMAIN_VALIDATION_ACTION=DISABLE

