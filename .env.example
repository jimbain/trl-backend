# Elasticsearch Sync Configuration
# These settings control the behavior of audio Elasticsearch synchronization
# Batch size for processing audios during sync operations (default: 100)
ELASTICSEARCH_SYNC_BATCH_SIZE=100

# Number of concurrent batches to process simultaneously (default: 1)
# Increase for better performance but be cautious with database load
ELASTICSEARCH_SYNC_CONCURRENCY=1

# Delay between batch operations in milliseconds (default: 3000)
# Prevents database connection exhaustion during large-scale syncs
ELASTICSEARCH_SYNC_BATCH_DELAY_MS=3000

# PostgreSQL statement timeout per batch query in milliseconds (default: 30000)
# Prevents long-running queries from blocking the connection pool
ELASTICSEARCH_SYNC_QUERY_TIMEOUT_MS=30000

# Delay before sending response to client in milliseconds (default: 2000)
# Ensures Elasticsearch indexing completes before client receives confirmation
# Applied to admin operations: update audio, bulk update, assign/deassign categories
ELASTICSEARCH_SYNC_RESPONSE_DELAY_MS=2000

BRANCH_API_KEY=

# Deep Link Generation Configuration
# Number of audios to process per batch (default: 50)
DEEP_LINK_BATCH_SIZE=50

# Delay between batch operations in milliseconds (default: 2000)
# Prevents database connection exhaustion during large-scale deep link generation
DEEP_LINK_BATCH_DELAY_MS=2000

# AI Recommendation Configuration
# Directory where the persisted FAISS index is stored. The index is rebuilt
# from scratch only if no persisted snapshot is found here; otherwise the
# saved index is loaded and any rows added since the snapshot are streamed in.
# For Docker: keep the default and use the named volume in docker-compose.yml.
# For pm2/server installs: set this to a persistent path on disk
# (e.g. /var/lib/trl/ai-reco). The directory will be created if missing.
AI_RECO_INDEX_DIR=/app/data/ai-reco
