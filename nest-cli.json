{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "ai/scripts/*.py", "outDir": "dist" },
      "ai/scripts/requirements.txt"
    ],
    "watchAssets": true
  }
}
